{
  "name": "nlexi",
  "version": "2.0.0",
  "private": true,
  "description": "NLexi — εκμάθηση Ολλανδικών για Έλληνες (Android)",
  "scripts": {
    "preview": "npx serve www",
    "prepare:web": "node scripts/copy-vendor.mjs",
    "android:add": "npx cap add android && node scripts/patch-android.mjs",
    "android:icons": "npx capacitor-assets generate --android",
    "android:sync": "npm run prepare:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/clipboard": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor-community/text-to-speech": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0"
  }
}
